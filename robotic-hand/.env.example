# Copy this file to .env and adjust if needed. Never commit .env.
# All values below are safe defaults for offline development.

# "mock" talks to the local FastAPI mock server (default, offline, deterministic).
# "real" talks to INFERENCE_ENDPOINT and requires INFERENCE_API_KEY.
INFERENCE_MODE=mock

# Cloud inference endpoint. The default matches `mock_server` run locally.
# For a real provider, set this to the provider's documented URL and check
# its current API shape before relying on it.
INFERENCE_ENDPOINT=http://127.0.0.1:8000/predict

# API key for real mode. Leave empty for mock mode. Read only from the
# environment; it is never written to logs or CSV files.
INFERENCE_API_KEY=

# Client-side timeout for one request, in seconds (connect + read).
INFERENCE_TIMEOUT_SECONDS=10

# Prototype latency target for a single round trip, in milliseconds.
LATENCY_TARGET_MS=5000

# Capture settings. If no camera is available the pipeline uses images/.
CAMERA_ENABLED=1
CAMERA_INDEX=0

# Optional path overrides (relative paths resolve against the project root).
# SAMPLE_IMAGES_DIR=images
# BENCHMARK_CSV_PATH=logs/latency.csv
# MEASUREMENTS_PATH=docs/measurements.md

# --- Real model endpoint (optional) ---
# Use real_server on a different port, e.g. http://127.0.0.1:8001/predict
# Install deps from requirements-real.txt. Model is COCO-trained.
MODEL_ID=PekingU/rtdetr_r18vd
DETECTION_THRESHOLD=0.5
