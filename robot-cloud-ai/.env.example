# Copy this file to .env and fill in your own values.
# Never commit .env or paste a real token into source code.

# Hugging Face user access token with "Inference Providers" permission.
HF_API_TOKEN=

# Image classification model served by the HF Inference Providers router.
HF_MODEL_ID=google/vit-base-patch16-224

# Optional: full endpoint override. Leave commented to derive it from the model.
# HF_ENDPOINT_URL=https://router.huggingface.co/hf-inference/models/google/vit-base-patch16-224

# HTTP timeouts in seconds: (connect, read).
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30

# Prototype latency benchmark (milliseconds), not a provider SLA.
LATENCY_TARGET_MS=5000
