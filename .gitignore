# ---------------------------------------------------------------------------
# Repository ignores: secrets, caches, runtime data, logs and broker state.
# ---------------------------------------------------------------------------

# Secrets — never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Runtime data (SQLite outboxes, processed/applied/conflict state)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Phase 6: captured photos and trained checkpoints are local artifacts
data/
training/runs/

# Generated logs and reports (committed docs/measurements.md is kept)
*.log
logs/*.csv
logs/ui/
!logs/.gitkeep

# Mosquitto broker runtime state (configuration is committed)
mosquitto/data/
mosquitto/log/

# Local tooling / environment
.freebuff/
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
